{
  "name": "graby-ts",
  "version": "1.1.1",
  "description": "TypeScript version of Graby content extraction library",
  "main": "dist/index.node.js",
  "types": "dist/index.node.d.ts",
  "type": "module",
  "exports": {
    ".": "./dist/index.node.js",
    "./node": "./dist/index.node.js",
    "./nativescript": "./dist/index.nativescript.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run lint && npm run build && npm test"
  },
  "keywords": [
    "readability",
    "content-extraction",
    "graby"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "chardet": "^2.2.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.15",
    "fontoxpath": "^3.34.0",
    "graby-ts-site-config": "^1.1.1",
    "html-entities": "^2.6.0",
    "iconv-lite": "^0.6.3",
    "linkedom": "^0.18.13",
    "url-parse": "^1.5.10",
    "xpath-to-selector": "^1.1.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@types/isomorphic-fetch": "^0.0.39",
    "@types/node": "^22.20.4",
    "@types/url-parse": "^1.4.11",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "@nativescript/core": "^8.0.0",
    "isomorphic-fetch": "^3.0.0"
  },
  "optionalDependencies": {
    "isomorphic-fetch": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NextReader-app/graby-ts.git"
  },
  "bugs": {
    "url": "https://github.com/NextReader-app/graby-ts/issues"
  },
  "homepage": "https://github.com/NextReader-app/graby-ts#readme"
}
